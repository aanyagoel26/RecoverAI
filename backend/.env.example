# RecoverAI backend configuration. Copy to `.env` (same folder) and fill in what you have.
# Everything in this file is BACKEND-ONLY. Never put any of these values in the frontend.
# Only the first block is needed to run locally — every integration can instead be added in the app
# (Integrations page), where secrets are encrypted and never shown again.

# ---- Core (required) ----
APP_ENV=development                     # development | production
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars   # signs login sessions; generate one (see SETUP_GUIDE.md)
SECRETS_KEY=                            # encrypts credentials saved in the app; any long random string. Set it in production.
DATABASE_URL=sqlite:///./recoverai.db   # local default. Supabase/Postgres: postgresql://USER:PASSWORD@HOST:5432/postgres
FRONTEND_URL=http://localhost:5173      # used to build customer checkout links and email links
PUBLIC_API_URL=http://localhost:8000    # public URL of this API; shown as your webhook URL
CORS_ORIGINS=http://localhost:5173      # comma separated list of allowed frontend origins

# ---- PayPal (optional here — prefer Integrations page) ----
# Server-wide fallback credentials. Used for the shared demo workspace and for any merchant
# that hasn't saved its own credentials in the app.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com   # Live: https://api-m.paypal.com
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD

# ---- AI provider (optional — the app works without it, using a labelled rules engine) ----
AI_PROVIDER=auto                        # auto | anthropic | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint 
GEMINI_API_KEY=                         # FREE: https://aistudio.google.com/apikey 
GEMINI_MODEL=gemini-3.8-flash
AI_TIMEOUT_SECONDS=45

# ---- Email (optional — without it, messages are stored as "preview only", never claimed as sent) ----
RESEND_API_KEY=
EMAIL_FROM=RecoverAI <recovery@yourdomain.com>   # must be on a domain verified in Resend

# ---- SMS (optional) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=                     # E.164, e.g. +15551234567

# ---- Agent and demo ----
AGENT_LOOP_SECONDS=60                   # background monitoring pass; 0 = only when triggered
SEED_DEMO_ON_START=true                 # creates the labelled demo workspace (demo@recoverai.dev)
DEMO_INTEGRATIONS_LOCKED=true           # keep the shared demo workspace's integrations read-only
